{
  "expo": {
    "name": "অগ্রহায়ণ",
    "slug": "ogrohayon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/amar-hisab-icon.png",
    "scheme": "ogrohayon",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FBF8F3",
      "image": "./assets/images/amar-hisab-icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/amar-hisab-icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}